{
  "framework": "vite",
  "buildCommand": "rm -rf dist && vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/living",
      "destination": "/living/",
      "permanent": false
    },
    {
      "source": "/m2a-access",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/m2a-access/:path*",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/living/",
      "destination": "https://gestr-living.vercel.app/"
    },
    {
      "source": "/living/:path*",
      "destination": "https://gestr-living.vercel.app/:path*"
    }
  ]
}
